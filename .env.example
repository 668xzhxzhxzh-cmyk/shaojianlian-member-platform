# 当前仅用 IP 验收时使用 http://公网IP；备案域名就绪后改为域名并启用 HTTPS
SITE_ADDRESS=http://localhost
PUBLIC_URL=http://localhost
COOKIE_SECURE=false

# DeepSeek 官方 API（不要提交真实密钥）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 腾讯官方 OpenClaw 微信通道。Gateway 只监听服务器回环网络，不得暴露公网。
OPENCLAW_GATEWAY_URL=http://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=
WEIXIN_ACCOUNT_ID=
# 会员先向机器人发送一条消息后填写目标会话 ID
WEIXIN_TARGET_ID=

# 可选兼容通道：企业微信群机器人官方 Webhook（完整地址，仅服务器保存）
WECOM_WEBHOOK_URL=

# 至少 32 字节随机字符，可用：openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL
POSTGRES_USER=shao
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=shao_platform

# 首次启动时写入/更新三种角色账号，请上线前全部修改
MEMBER_PHONE=13800005206
MEMBER_PASSWORD=Member@2026
COACH_PHONE=13800006608
COACH_PASSWORD=Coach@2026
ADMIN_PHONE=13800008808
ADMIN_PASSWORD=Admin@2026
