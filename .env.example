# 当前仅用 IP 验收时使用 http://公网IP；备案域名就绪后改为域名并启用 HTTPS
SITE_ADDRESS=http://localhost
PUBLIC_URL=http://localhost
COOKIE_SECURE=false

# DeepSeek 官方 API（由原生 Hermes 使用；不要提交真实密钥）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 原生 Hermes API。轻量主机原生部署使用 127.0.0.1，Docker API 使用 host.docker.internal。
HERMES_API_URL=http://host.docker.internal:8642
HERMES_API_KEY=

# 企业微信智能机器人（AI Bot/API 模式）凭据只写入 Hermes 的
# /var/lib/hermes/.hermes/.env，不写入网站 .env：
# WECOM_BOT_ID=
# WECOM_SECRET=
# WECOM_DM_POLICY=allowlist
# WECOM_ALLOWED_USERS=企业微信教练userid
# WECOM_GROUP_POLICY=allowlist

# 网站内部 Hermes 工具与企业微信客户联系官方 API。
# HERMES_TOOL_TOKEN 必须是至少 32 字节的独立随机令牌，网站与 Hermes MCP 使用同一值。
HERMES_TOOL_TOKEN=
WECOM_ALLOWED_COACH_USERIDS=
WECOM_CORP_ID=
WECOM_CONTACT_SECRET=

# 至少 32 字节随机字符，可用：openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL
POSTGRES_USER=shao
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=shao_platform

# 首次启动时写入/更新三种角色账号，请上线前全部修改
MEMBER_PHONE=13800005206
MEMBER_PASSWORD=Member@2026
COACH_PHONE=13800006608
COACH_PASSWORD=Coach@2026
ADMIN_PHONE=13800008808
ADMIN_PASSWORD=Admin@2026
