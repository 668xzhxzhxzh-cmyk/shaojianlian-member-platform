# 域名备案并解析到阿里云 ECS 后填写，例如 fit.example.com
DOMAIN=localhost

# DeepSeek 官方 API（不要提交真实密钥）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 企业微信群机器人官方 Webhook（完整地址，仅服务器保存）
WECOM_WEBHOOK_URL=

# 至少 32 字节随机字符，可用：openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL
POSTGRES_USER=shao
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=shao_platform

# 首次启动时写入/更新三种角色账号，请上线前全部修改
MEMBER_PHONE=13800005206
MEMBER_PASSWORD=Member@2026
COACH_PHONE=13800006608
COACH_PASSWORD=Coach@2026
ADMIN_PHONE=13800008808
ADMIN_PASSWORD=Admin@2026
