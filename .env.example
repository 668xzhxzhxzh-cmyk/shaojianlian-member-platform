# 当前仅用 IP 验收时使用 http://公网IP；备案域名就绪后改为域名并启用 HTTPS
SITE_ADDRESS=http://localhost
PUBLIC_URL=http://localhost
COOKIE_SECURE=false

# DeepSeek 官方 API（由原生 Hermes 使用；不要提交真实密钥）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 原生 Hermes API。轻量主机原生部署使用 127.0.0.1，Docker API 使用 host.docker.internal。
HERMES_API_URL=http://host.docker.internal:8642
HERMES_API_KEY=

# 企业微信自建应用回调、应用消息和客户联系官方 API。
# HERMES_TOOL_TOKEN 必须是至少 32 字节的独立随机令牌，网站与 Hermes MCP 使用同一值。
HERMES_TOOL_TOKEN=
WECOM_ALLOWED_COACH_USERIDS=
WECOM_CORP_ID=
WECOM_APP_AGENT_ID=
WECOM_APP_SECRET=
WECOM_CONTACT_SECRET=
# 与企业微信“群发助手 -> 设置群发规则”保持一致：daily、weekly 或 monthly。
WECOM_GROUP_SEND_RULE=daily
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=
WECOM_CALLBACK_PUBLIC_URL=https://your-filed-domain.example/api/wecom/callback

# 微信客服是普通微信客户向 Hermes 发送文字/图片并获得自动回复的官方入口。
# 客户联系聊天正文不会进入自建应用回调，因此必须单独配置微信客服回调。
WECOM_KF_SECRET=
WECOM_KF_OPEN_KFID=
WECOM_KF_CALLBACK_TOKEN=
WECOM_KF_CALLBACK_AES_KEY=
WECOM_KF_CALLBACK_PUBLIC_URL=https://your-filed-domain.example/api/wecom/kf/callback

# DeepSeek V4 是纯文本模型；Hermes 使用阿里云百炼 Qwen-VL 只读解析图片，
# 再将结构化图片描述交给 DeepSeek 生成会员回复。真实 Key 仅放服务器环境变量。
DASHSCOPE_API_KEY=
HERMES_VISION_MODEL=qwen3-vl-flash
HERMES_VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 至少 32 字节随机字符，可用：openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL
POSTGRES_USER=shao
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=shao_platform

# 首次启动时写入/更新三种角色账号，请上线前全部修改
MEMBER_PHONE=13800005206
MEMBER_PASSWORD=Member@2026
COACH_PHONE=13800006608
COACH_PASSWORD=Coach@2026
ADMIN_PHONE=13800008808
ADMIN_PASSWORD=Admin@2026
