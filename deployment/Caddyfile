{$SITE_ADDRESS:http://localhost} {
  encode zstd gzip

  @api path /api/* /health
  handle @api {
    reverse_proxy api:8788
  }

  handle {
    reverse_proxy web:3000
  }

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  log {
    output stdout
    format json
  }
}
