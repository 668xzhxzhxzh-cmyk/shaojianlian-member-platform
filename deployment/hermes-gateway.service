[Unit]
Description=Native Hermes Agent API and Weixin Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
Environment=HOME=/var/lib/hermes
Environment=HERMES_HOME=/var/lib/hermes/.hermes
WorkingDirectory=/var/lib/hermes/.hermes/workspace
ExecStart=/var/lib/hermes/.hermes/hermes-agent/venv/bin/hermes gateway run
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/hermes/.hermes
InaccessiblePaths=/opt/shao-coach
MemoryMax=850M
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
