[Unit]
Description=Shao Coach Web
After=network-online.target shao-api.service
Wants=network-online.target

[Service]
Type=simple
User=shaoapp
Group=shaoapp
WorkingDirectory=/opt/shao-coach
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
EnvironmentFile=-/etc/default/shao-coach-web
ExecStart=/usr/bin/node /opt/shao-coach/.next/standalone/server.js
Restart=always
RestartSec=4
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
MemoryMax=650M
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
