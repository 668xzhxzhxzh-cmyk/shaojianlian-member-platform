[Unit]
Description=Hermes Desktop Remote Backend
After=network-online.target hermes-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
Environment=HOME=/var/lib/hermes
Environment=HERMES_HOME=/var/lib/hermes/.hermes
EnvironmentFile=-/var/lib/hermes/.hermes/.env
WorkingDirectory=/var/lib/hermes/.hermes/workspace
ExecStart=/var/lib/hermes/.hermes/hermes-agent/venv/bin/hermes serve --host 127.0.0.1 --port 9119
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/hermes/.hermes
InaccessiblePaths=/opt/shao-coach
MemoryMax=850M
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
